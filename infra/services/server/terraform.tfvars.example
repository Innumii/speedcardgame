aws_region = "us-east-1"
image_tag  = "latest"
image_repo = "ryanljk/g4t2-server-service"
assign_public_ip = true

github_username     = "Ryanljk"
github_repo_name    = "speedcardgame"
ghcr_pat_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:ghcr-auth-credentials-xxxxxx"

# Optional: create game.<base_domain> Route53 alias to the server NLB.
# If base_domain is omitted, Terraform tries to derive it from the ALB stack output (api.<base_domain>).
# base_domain          = "example.com"

# Optional explicit override if cards routing is not auto-wired from the ALB stack
# cards_service_base_url = "https://api.example.com"
# cards_service_host     = "api.example.com"
# cards_service_port     = 443
