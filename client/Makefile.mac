# Makefile.mac — macOS build using Homebrew SDL2 + OpenSSL
CXX := g++
STD := -std=c++17
INCLUDES := -I include

BREW_PREFIX    := $(shell brew --prefix)
OPENSSL_PREFIX := $(shell brew --prefix openssl@3)

# Use pkg-config for SDL2_ttf and SDL2_image; manually set SDL2 include
# to parent dir so <SDL2/SDL.h> style includes resolve correctly
SDL2_CFLAGS := -I$(BREW_PREFIX)/include -D_THREAD_SAFE
SDL2_LIBS   := -L$(BREW_PREFIX)/lib -lSDL2 -lSDL2_ttf -lSDL2_image -lSDL2_mixer

CXXFLAGS := $(STD) $(INCLUDES) $(SDL2_CFLAGS) \
             -I$(OPENSSL_PREFIX)/include
LDFLAGS  := $(SDL2_LIBS) \
			 -L$(OPENSSL_PREFIX)/lib -lssl -lcrypto \
			 -framework CoreFoundation -framework Security

BUILD_DIR := build
SRCS      := $(wildcard src/*.cpp src/*/*.cpp src/*/*/*.cpp)
OBJS      := $(patsubst src/%.cpp,$(BUILD_DIR)/%.o,$(SRCS))
DEPS      := $(OBJS:.o=.d)


DYLIBS := \
	$(BREW_PREFIX)/lib/libSDL2.dylib \
	$(BREW_PREFIX)/lib/libSDL2_ttf.dylib \
	$(BREW_PREFIX)/lib/libSDL2_image.dylib \
	$(OPENSSL_PREFIX)/lib/libssl.dylib \
	$(OPENSSL_PREFIX)/lib/libcrypto.dylib

all: main copy-dylibs


main: $(OBJS)
	$(CXX) $(STD) -o $@ $^ $(LDFLAGS)

copy-dylibs:
	@for dylib in $(DYLIBS); do \
	  cp -f $$dylib . 2>/dev/null || echo "Warning: $$dylib not found"; \
	done

$(BUILD_DIR)/%.o: src/%.cpp
	@mkdir -p $(@D)
	$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@

-include $(DEPS)

clean:
	rm -rf $(BUILD_DIR) main

.PHONY: all clean