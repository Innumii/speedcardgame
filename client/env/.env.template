# Template environment variable file for client application
# Copy this file to .env and fill in the values before running the client.
USE_AWS_SERVICES=true
AWS_REGION=us-east-1

# Game Server
DOCKER_GAME_SERVER_HOST=
DOCKER_GAME_SERVER_PORT=4000
AWS_GAME_SERVER_HOST=<terraform-output-game_server_service_external_endpoint>
AWS_GAME_SERVER_PORT=4000
# Optional TLS hostname override for game server certificate validation
# Example (current deployed cert CN): localhost
GAME_SERVER_TLS_SERVER_NAME=

# Cards Service
DOCKER_CARDS_SERVICE_HOST=
DOCKER_CARDS_SERVICE_PORT=8080
AWS_CARDS_SERVICE_HOST=<terraform-output-cards_service_external_endpoint>
AWS_CARDS_SERVICE_PORT=443

# Auth Service
DOCKER_AUTH_SERVICE_HOST=
DOCKER_AUTH_SERVICE_PORT=8081
AWS_AUTH_SERVICE_HOST=<terraform-output-auth_service_external_endpoint>
AWS_AUTH_SERVICE_PORT=443

# Feaure flags
DEBUG_ENV_UTILS=false   
