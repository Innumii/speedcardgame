aws_region = "us-east-1"
image_tag  = "latest"
image_repo = "FYL-Studios/speedcardgame"
assign_public_ip = true

use_managed_data_stack = true
postgres_sslmode = "require"
# data_stack_state_path = "../../data/terraform.tfstate"

use_managed_alb_stack = true
# alb_stack_state_path = "../alb/terraform.tfstate"

# Optional manual overrides when use_managed_data_stack = false
# postgres_host     = "your-postgres-host"
# postgres_user     = "authuser"
# postgres_password_secret_arn = "arn:aws:secretsmanager:...:secret:speedcardgame-auth-runtime"
# cards_service_base_url_secret_arn = "arn:aws:secretsmanager:...:secret:speedcardgame-auth-runtime"
# tls_secret_name = "game-server-tls"
# postgres_password = "change-me" # fallback only when not using Secrets Manager
# postgres_db       = "authdb"
# postgres_port     = 5432
# redis_host        = "your-redis-host"
# redis_port        = 6379

# Optional manual ALB wiring when use_managed_alb_stack = false
# alb_security_group_id = "sg-xxxxxxxx"
# target_group_arn      = "arn:aws:elasticloadbalancing:...:targetgroup/speedcard-auth-tg/xxxxxxxx"

# Optional fallback override when Secrets Manager key CARDS_SERVICE_BASE_URL is unavailable.
# cards_service_base_url = "https://example.com"
cards_service_port = 443

# Logging toggles
debug_log_enabled = false
http_request_log_enabled = true
