CXX := g++
STD := -std=c++17
INCLUDES := -I include
LIBDIR := -L lib
LIBS := -lSDL2 -lSDL2_ttf -lSDL2_image -lSDL2_mixer -lssl -lcrypto
BUILD_DIR := build
MKDIR_P := mkdir -p

CXXFLAGS := -g -O1 -Wall -Wextra -Wshadow -fsanitize=address -fstack-protector-all
LDFLAGS := -fsanitize=address

# Pick up .cpp files in src and one/two-level subdirs.
SRCS := $(wildcard src/*.cpp src/*/*.cpp src/*/*/*.cpp)
OBJS := $(patsubst src/%.cpp,$(BUILD_DIR)/%.o,$(SRCS))

all: main

main: $(OBJS)
	$(CXX) $(STD) $(LDFLAGS) -o $@ $^ $(LIBDIR) $(LIBS)

$(BUILD_DIR)/%.o: src/%.cpp
	$(MKDIR_P) $(@D)
	$(CXX) $(STD) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

clean:
	$(RM) -r $(BUILD_DIR) main
