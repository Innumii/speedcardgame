## ------------------------------------------------------- ##
##  Common variables for all stacks                        ##
## ------------------------------------------------------- ##
aws_region            = "ap-southeast-1"
base_domain           = 
enable_https_listener = true
acm_certificate_arn   = 

github_username     = 
github_repo_name    = 
ghcr_pat_secret_arn = 

image_tag              = "latest"
assign_public_ip       = true
use_aws_services       = true
use_managed_data_stack = true
postgres_sslmode       = "require"

## ------------------------------------------------------- ##
##  Service image repositories (no key collisions)         ##
## ------------------------------------------------------- ##
auth_image_repo   = 
cards_image_repo  = 
server_image_repo = 

## ------------------------------------------------------- ##
##  Services                                               ##
## ------------------------------------------------------- ##
auth_desired_count   = 1
auth_cpu             = "256"
auth_memory          = "512"
cards_desired_count  = 1
cards_cpu            = "256"
cards_memory         = "512"
server_desired_count = 1
server_cpu           = "256"
server_memory        = "512"

## ------------------------------------------------------- ##
##  ALB/NLB Configurations                                 ##
## ------------------------------------------------------- ##
nlb_internal                      = false
enable_cross_zone_load_balancing  = true
enable_source_ip_stickiness       = false
target_group_deregistration_delay = 30

## ------------------------------------------------------- ##
##  Optional Postgres/Redis overrides for data stack       ##
## ------------------------------------------------------- ##
# Auth Postgres
# auth_postgres_user     = "authuser"
# auth_postgres_password = "authpass"
# auth_postgres_db       = "authdb"
# auth_postgres_port     = 5432

# Cards Postgres
# cards_postgres_user     = "cardsuser"
# cards_postgres_password = "cardspass"
# cards_postgres_db       = "cardsdb"
# cards_postgres_port     = 5432

# Auth Redis
# redis_host              = "your-redis-host"
# auth_redis_port         = 6379

## ------------------------------------------------------- ##
##  Data stack secret-manager values                        ##
## ------------------------------------------------------- ##
github_token             = 
skip_secrets_manager     = true
existing_ghcr_secret_arn = 

# Stripe Payment Configuration
stripe_secret_key     = 
stripe_webhook_secret = 

# JWT Secret for internal API authentication
internal_api_key=

# TLS Secret
tls_key = 
tls_cert = 
