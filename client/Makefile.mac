# Makefile.mac — macOS build using Homebrew SDL2 + OpenSSL
CXX := g++
STD := -std=c++17
INCLUDES := -I include

# Resolve Homebrew prefix at build time (works on Intel + Apple Silicon)
BREW_PREFIX    := $(shell brew --prefix)
OPENSSL_PREFIX := $(shell brew --prefix openssl@3)

SDL2_CFLAGS := $(shell sdl2-config --cflags)
SDL2_LIBS   := $(shell sdl2-config --libs)

CXXFLAGS := $(STD) $(INCLUDES) $(SDL2_CFLAGS) \
             -I$(OPENSSL_PREFIX)/include
LDFLAGS  := $(SDL2_LIBS) -lSDL2_ttf -lSDL2_image \
             -L$(OPENSSL_PREFIX)/lib -lssl -lcrypto

BUILD_DIR := build
SRCS      := $(wildcard src/*.cpp src/*/*.cpp src/*/*/*.cpp)
OBJS      := $(patsubst src/%.cpp,$(BUILD_DIR)/%.o,$(SRCS))
DEPS      := $(OBJS:.o=.d)

all: main

main: $(OBJS)
	$(CXX) $(STD) -o $@ $^ $(LDFLAGS)

$(BUILD_DIR)/%.o: src/%.cpp
	@mkdir -p $(@D)
	$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@

-include $(DEPS)

clean:
	rm -rf $(BUILD_DIR) main

.PHONY: all clean