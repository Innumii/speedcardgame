{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/cards/count": {
            "get": {
                "description": "Returns the total number of cards in the database",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "cards"
                ],
                "summary": "Get card count",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "integer",
                                "format": "int64"
                            }
                        }
                    },
                    "500": {
                        "description": "Failed to count cards",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/cards/{id}/image": {
            "get": {
                "description": "Serves the image file for a card by its ID",
                "produces": [
                    "image/png"
                ],
                "tags": [
                    "cards"
                ],
                "summary": "Get card image",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Card ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "404": {
                        "description": "Image not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/decks": {
            "get": {
                "description": "Returns all decks for all users",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "decks"
                ],
                "summary": "List all decks",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.Deck"
                            }
                        }
                    },
                    "500": {
                        "description": "Failed to retrieve decks",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "post": {
                "description": "Creates a new deck for a user. Replaces existing deck. Must contain exactly DECK_SIZE cards (default 30).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "decks"
                ],
                "summary": "Create a deck",
                "parameters": [
                    {
                        "description": "Deck details",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.Deck"
                        }
                    },
                    "400": {
                        "description": "Invalid input or wrong deck size",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Failed to create deck",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "delete": {
                "description": "Deletes a deck by user ID",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "decks"
                ],
                "summary": "Delete a deck",
                "parameters": [
                    {
                        "description": "User ID",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid input",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Failed to delete deck",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/decks/fill": {
            "post": {
                "description": "Automatically fills a deck for a user based on their inventory",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "decks"
                ],
                "summary": "Fill deck from inventory",
                "parameters": [
                    {
                        "description": "User ID",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.Deck"
                        }
                    },
                    "400": {
                        "description": "Invalid input",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Inventory not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Failed to fill deck",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/decks/{uid}": {
            "get": {
                "description": "Returns a user's current deck",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "decks"
                ],
                "summary": "Get deck by user ID",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "User ID",
                        "name": "uid",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.Deck"
                        }
                    },
                    "400": {
                        "description": "Invalid user ID",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Deck not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/inventories": {
            "get": {
                "description": "Returns all user inventories. Card quantities normalized on read.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "inventories"
                ],
                "summary": "List all inventories",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.Inventory"
                            }
                        }
                    },
                    "500": {
                        "description": "Failed to retrieve inventories",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "put": {
                "description": "Adds cards to a user's inventory. Max 4 copies per card.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "inventories"
                ],
                "summary": "Update inventory cards",
                "parameters": [
                    {
                        "description": "User ID and cards to add",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.Inventory"
                        }
                    },
                    "400": {
                        "description": "Invalid input",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Failed to update inventory",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "post": {
                "description": "Creates a new inventory for a user. If no cards provided, assigns default starter cards and 1000 coins.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "inventories"
                ],
                "summary": "Create inventory",
                "parameters": [
                    {
                        "description": "User ID and optional cards",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.Inventory"
                        }
                    },
                    "400": {
                        "description": "Invalid input",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Failed to create inventory",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/inventories/coins": {
            "put": {
                "description": "Sets a user's coin balance to an exact value",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "inventories"
                ],
                "summary": "Set inventory coins",
                "parameters": [
                    {
                        "description": "User ID and coin amount",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "400": {
                        "description": "Invalid input",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Failed to update coins",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/inventories/coins/add": {
            "put": {
                "description": "Adds or subtracts coins from a user's balance",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "inventories"
                ],
                "summary": "Add coins to inventory",
                "parameters": [
                    {
                        "description": "User ID and coins to add",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "400": {
                        "description": "Invalid input",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Failed to add coins",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/inventories/{uid}": {
            "get": {
                "description": "Returns a specific user's inventory. Card quantities normalized on read.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "inventories"
                ],
                "summary": "Get inventory by user ID",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "User ID",
                        "name": "uid",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.Inventory"
                        }
                    },
                    "400": {
                        "description": "Missing uid",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Failed to retrieve inventory",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/payments/card": {
            "post": {
                "description": "Processes a direct card payment for a coin package. Only available when ALLOW_DIRECT_CARD_PAYMENTS is enabled.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "payments"
                ],
                "summary": "Process direct card payment",
                "parameters": [
                    {
                        "description": "Card payment details",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/services.processCardPaymentRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Invalid input or unsupported package",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "402": {
                        "description": "Payment not completed",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "403": {
                        "description": "Direct card payments disabled",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "502": {
                        "description": "Failed to process payment",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "503": {
                        "description": "Payments module not configured",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/payments/checkout-session": {
            "post": {
                "description": "Creates a Stripe checkout session for a coin package purchase",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "payments"
                ],
                "summary": "Create checkout session",
                "parameters": [
                    {
                        "description": "Checkout session details",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/services.createCoinCheckoutRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Invalid input or unsupported package",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "502": {
                        "description": "Failed to create checkout session",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "503": {
                        "description": "Payments module not configured",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/payments/checkout-session/status": {
            "get": {
                "description": "Checks the status of a Stripe checkout session and credits coins if payment is confirmed",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "payments"
                ],
                "summary": "Get checkout session status",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Stripe checkout session ID",
                        "name": "session_id",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Missing or invalid session data",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "502": {
                        "description": "Failed to retrieve session",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "503": {
                        "description": "Payments module not configured",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/payments/packages": {
            "get": {
                "description": "Returns all available coin packages for purchase",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "payments"
                ],
                "summary": "List coin packages",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/payments/webhook": {
            "post": {
                "description": "Receives and processes Stripe webhook events. On successful checkout, credits coins to the user's inventory.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "payments"
                ],
                "summary": "Handle payment webhook",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Stripe webhook signature",
                        "name": "Stripe-Signature",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid webhook payload or metadata",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Failed to apply coin purchase",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "503": {
                        "description": "Payments module not configured",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "models.CardCounts": {
            "type": "object",
            "additionalProperties": {
                "type": "integer"
            }
        },
        "models.Deck": {
            "type": "object",
            "properties": {
                "cards": {
                    "description": "Map of card ID to quantity",
                    "allOf": [
                        {
                            "$ref": "#/definitions/models.CardCounts"
                        }
                    ]
                },
                "uid": {
                    "type": "integer"
                }
            }
        },
        "models.Inventory": {
            "type": "object",
            "properties": {
                "cards": {
                    "description": "Map of card ID to quantity",
                    "allOf": [
                        {
                            "$ref": "#/definitions/models.CardCounts"
                        }
                    ]
                },
                "coins": {
                    "description": "User's coin balance",
                    "type": "integer"
                },
                "uid": {
                    "type": "integer"
                }
            }
        },
        "services.createCoinCheckoutRequest": {
            "type": "object",
            "properties": {
                "cancel_url": {
                    "type": "string"
                },
                "package_id": {
                    "type": "string"
                },
                "success_url": {
                    "type": "string"
                },
                "uid": {
                    "type": "integer"
                }
            }
        },
        "services.processCardPaymentRequest": {
            "type": "object",
            "properties": {
                "card_number": {
                    "type": "string"
                },
                "cardholder_name": {
                    "type": "string"
                },
                "cvc": {
                    "type": "string"
                },
                "exp_month": {
                    "type": "integer"
                },
                "exp_year": {
                    "type": "integer"
                },
                "package_id": {
                    "type": "string"
                },
                "uid": {
                    "type": "integer"
                }
            }
        }
    }
}